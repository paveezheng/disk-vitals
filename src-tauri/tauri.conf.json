{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "disk-vitals",
  "version": "0.1.0",
  "identifier": "com.yanzzp.disk-vitals",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "disk-vitals",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
